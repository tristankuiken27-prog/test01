    rDistanceB : LREAL := 10.0; // 10 omwentelingen / units
	
	rCentraleSnelheid : REAL := 100.0; // Standaard snelheid (bijv. 100 mm/s of deg/s)
	
	// Start-commando's voor Homing
    bStartHomingA : BOOL := FALSE;
    bStartHomingB : BOOL := FALSE;
    
    // Status van de homing
    bHomingDoneA  : BOOL := FALSE;
    bHomingDoneB  : BOOL := FALSE;
END_VAR</Single>
