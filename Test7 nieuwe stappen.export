      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">b3a25632-ef8a-48c0-93de-e1646de91ca8</Single>
        <Single Name="ParentGuid" Type="System.Guid">74cdde81-67e0-4027-a88e-bcd91735fd47</Single>
        <Single Name="Name" Type="string">Motion_Task_PRG</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639281763851130376</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// --- MOTOR A ---
fbPowerA(
    Axis:= SM_Drive_GenericDSP402,
    Enable:= GVL.bPowerA,
    bRegulatorOn:= GVL.bPowerA,
    bDriveStart:= GVL.bPowerA
);

fbMoveRelA(
    Axis:= SM_Drive_GenericDSP402,
    Execute:= GVL.bMoveA,
    Distance:= GVL.rDistanceA,     // Ingediende verplaatsing (bijv. 10 omwentelingen)
    Velocity:= GVL.rCentraleSnelheid, // Koppel aan de centrale snelheid
    Acceleration:= 1000,
    Deceleration:= 1000,
    Jerk:= 5000
);

// --- MOTOR B ---
fbPowerB(
    Axis:= SM_Drive_GenericDSP402_3,
    Enable:= GVL.bPowerB,
    bRegulatorOn:= GVL.bPowerB,
    bDriveStart:= GVL.bPowerB
);

fbMoveRelB(
    Axis:= SM_Drive_GenericDSP402_3,
    Execute:= GVL.bMoveB,
    Distance:= GVL.rDistanceB,     // Ingediende verplaatsing
    Velocity:= GVL.rCentraleSnelheid, // Koppel aan de centrale snelheid
    Acceleration:= 1000,
    Deceleration:= 1000,
    Jerk:= 5000
);

// Homing Motor A (Block Homing via -1 op CoE 6098)
fbHomeA(
    Axis:= SM_Drive_GenericDSP402,
    Execute:= GVL.bStartHomingA,
    Position:= 0.0, // Zet de positie op 0.0 zodra de rand geraakt is
    Done=&gt; GVL.bHomingDoneA
);

// Homing Motor B
fbHomeB(
    Axis:= SM_Drive_GenericDSP402_3,
    Execute:= GVL.bStartHomingB,
    Position:= 0.0,
    Done=&gt; GVL.bHomingDoneB
);</Single>
            <Single Name="LineInfoPersistence" Type="string">b3a25632-ef8a-48c0-93de-e1646de91ca8_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM Motion_Task_PRG
VAR
  // Functieblokken Motor A
    fbPowerA   : MC_Power;
    fbMoveRelA : MC_MoveRelative;

    // Functieblokken Motor B
    fbPowerB   : MC_Power;
    fbMoveRelB : MC_MoveRelative;
	
	fbHomeA : MC_Home;
    fbHomeB : MC_Home;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">b3a25632-ef8a-48c0-93de-e1646de91ca8_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">289</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">74cdde81-67e0-4027-a88e-bcd91735fd47</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">79ce8490-0f53-4da9-882c-bc9dc7ba6e4f</Single>
        <Single Name="ParentGuid" Type="System.Guid">74cdde81-67e0-4027-a88e-bcd91735fd47</Single>
        <Single Name="Name" Type="string">PLC_PRG</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639281790113189377</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Doorkoppelen van MainTask naar GVL
GVL.bPowerA    := bPowerA;
GVL.bMoveA     := bMoveA;
GVL.rSpeedA    := rSpeedA;
GVL.rDistanceA := rDistanceA;

GVL.bPowerB    := bPowerB;
GVL.bMoveB     := bMoveB;
GVL.rSpeedB    := rSpeedB;
GVL.rDistanceB := rDistanceB;

// 1. Motor aan- en uitzetten 
IF bknopaan THEN
	bPowerA := TRUE;
	bPowerB := TRUE;
	bknopaan:= FALSE;
END_IF

// 2. Reset de move-commando's aan het begin van de cyclus
GVL.bMoveA := FALSE;
GVL.bMoveB := FALSE;

// BEIDE MOTOREN
IF bStartlinksrechts THEN
	GVL.rDistanceA := 10.0;
	GVL.rDistanceB := -10.0;
	GVL.bMoveA 	   := TRUE;
	GVL.bMoveB 	   := TRUE;
	bstartlinksrechts := FALSE;
END_IF

IF bStartrechtslinks THEN
	GVL.rDistanceA := -10.0;
	GVL.rDistanceB := 10.0;
	GVL.bMoveA 	   := TRUE;
	GVL.bMoveB 	   := TRUE;
	bstartrechtslinks := FALSE;
END_IF

// --- BEIDE MOTOREN ---
IF bStartBeideRechts THEN
    GVL.rDistanceA    := 10.0;
    GVL.rDistanceB    := 10.0;
    GVL.bMoveA        := TRUE;
    GVL.bMoveB        := TRUE;
    bStartBeideRechts := FALSE;
END_IF;

IF bStartBeideLinks THEN
    GVL.rDistanceA   := -10.0;
    GVL.rDistanceB   := -10.0;
    GVL.bMoveA       := TRUE;
    GVL.bMoveB       := TRUE;
    bStartBeideLinks := FALSE;
END_IF;

// --- MOTOR A INDIVIDUEEL ---
IF bStartARechts THEN
    GVL.rDistanceA := 10.0;
    GVL.bMoveA     := TRUE;
    bStartARechts  := FALSE;
END_IF;

IF bStartALinks THEN
    GVL.rDistanceA := -10.0;
    GVL.bMoveA     := TRUE;
    bStartALinks   := FALSE;
END_IF;

// --- MOTOR B INDIVIDUEEL ---
IF bStartBRechts THEN
    GVL.rDistanceB := 10.0;
    GVL.bMoveB     := TRUE;
    bStartBRechts  := FALSE;
END_IF;

IF bStartBLinks THEN
    GVL.rDistanceB := -10.0;
    GVL.bMoveB     := TRUE;
    bStartBLinks   := FALSE;
END_IF;

// Pulssturing voor Kalibratie Motor B
IF bKnopHomingB THEN
    GVL.bStartHomingB := TRUE;
    bKnopHomingB       := FALSE; // Reset HMI knop
ELSE
    GVL.bStartHomingB := FALSE;
END_IF;

// 1. Reset-logica voor het opheffen van een geblokkeerde as/fout
fbResetA(Axis := SM_Drive_GenericDSP402, Execute := bResetKnop);
IF fbResetA.Done THEN
    bResetKnop := FALSE;
END_IF;

// 2. Pulssignaal voor Homing (stopt direct na 1 cyclus)
IF bKnopHomingA THEN
    GVL.bStartHomingA := TRUE;
    bKnopHomingA       := FALSE; // Reset HMI knop
ELSE
    GVL.bStartHomingA := FALSE; // Direct weer FALSE maken!
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">79ce8490-0f53-4da9-882c-bc9dc7ba6e4f_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_PRG
VAR
  	bPowerA    : BOOL := FALSE;
    bMoveA     : BOOL := FALSE;
    rSpeedA    : LREAL := 3.0;
    rDistanceA : LREAL := 10.0;

    bPowerB    : BOOL := FALSE;
    bMoveB     : BOOL := FALSE;
    rSpeedB    : LREAL := 3.0;
    rDistanceB : LREAL := 10.0;
	// Knoppen voor aanzetten van motor
	bknopaan : BOOL := FALSE; // aanzetten
	
	// Knoppen voor beide motoren
    bStartBeideRechts : BOOL := FALSE; // allebei +10
    bStartBeideLinks  : BOOL := FALSE; // allebei -10
	
	// Knoppen voor beide motoren asynchrone beweging
	BStartlinksrechts : BOOL := FALSE; // +10 en -10
	BStartrechtslinks : BOOL := FALSE; // -10 en +10
	
    // Knoppen voor Motor A
    bStartARechts     : BOOL := FALSE; // Motor A +10
    bStartALinks      : BOOL := FALSE; // Motor A -10

    // Knoppen voor Motor B
    bStartBRechts     : BOOL := FALSE; // Motor B +10
    bStartBLinks      : BOOL := FALSE; // Motor B -10
	
	bKnopHomingA : BOOL := FALSE;
    bResetKnop   : BOOL := FALSE; // Knop om de as te resetten bij blokkade
    fbResetA     : MC_Reset;
    bKnopHomingB : BOOL := FALSE; // Knop op visualisatie voor Motor B
END_VAR</Single>
